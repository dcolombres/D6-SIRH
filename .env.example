APP_NAME=D6-SIRH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3848

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Docker Compose (servicio mysql): DB_HOST=mysql
# PHP en el host contra MySQL publicado: DB_HOST=127.0.0.1 DB_PORT=3307
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=d6_sirh
DB_USERNAME=d6
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

HTTP_PORT=3848
MYSQL_PUBLISH_PORT=3307
IMAGE_NAME=d6-sirh-app
IMAGE_TAG=local

RUN_MIGRATIONS=true
RUN_SEEDERS=true
CACHE_CONFIG=false

VITE_APP_NAME="${APP_NAME}"
