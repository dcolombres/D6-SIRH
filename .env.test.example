# =============================================================================
# D6-SIRH — variables para ambiente de TEST
# Copiar a .env en el servidor / pipeline antes de: docker compose up -d --build
# =============================================================================

APP_NAME=D6-SIRH
APP_ENV=testing
APP_DEBUG=true
# Obligatorio. Generar con:
#   docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# URL pública del ambiente de test (ajustar al host/ingress real)
APP_URL=http://localhost:3848

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Dentro de la red Docker el host es "mysql". Si usan DB externa, cambiar host/puerto.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=d6_sirh
DB_USERNAME=d6
DB_PASSWORD=cambiar_password_test
MYSQL_ROOT_PASSWORD=cambiar_root_test

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Puerto HTTP publicado en el host
HTTP_PORT=3848
MYSQL_PUBLISH_PORT=3307

# Imagen
IMAGE_NAME=d6-sirh-app
IMAGE_TAG=test

# Bootstrap en entrypoint
RUN_MIGRATIONS=true
# true = carga catálogo demo (23 módulos). En test limpio suele ser true la 1ª vez.
RUN_SEEDERS=true
CACHE_CONFIG=true

VITE_APP_NAME="${APP_NAME}"
